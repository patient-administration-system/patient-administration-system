{
  "realm": "pas",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "A patient signing in to see their own appointments"
      },
      {
        "name": "staff",
        "description": "Hospital staff using the administration frontend"
      },
      {
        "name": "admin",
        "description": "Administrators, including message-template editing"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pas-frontend",
      "name": "PAS frontend",
      "enabled": true,
      "publicClient": false,
      "secret": "pas_dev_client_secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/signin/oidc/callback",
        "http://localhost:4173/signin/oidc/callback",
        "http://localhost:3000/signin/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/signin##http://localhost:4173/signin##http://localhost:3000/signin"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "person_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "person_id",
            "claim.name": "person_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "patient",
      "email": "patient@example.test",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "person_id": [
          "00000000-0000-0000-0000-000000000000"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "patient",
          "temporary": false
        }
      ],
      "realmRoles": [
        "patient"
      ],
      "firstName": "Pat",
      "lastName": "Patient"
    },
    {
      "username": "admin",
      "email": "admin@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "seeded test authenticator",
          "secretData": "{\"value\": \"JBSWY3DPEHPK3PXP\"}",
          "credentialData": "{\"subType\": \"totp\", \"digits\": 6, \"period\": 30, \"algorithm\": \"HmacSHA1\", \"secretEncoding\": \"BASE32\"}"
        }
      ],
      "realmRoles": [
        "staff",
        "admin"
      ],
      "firstName": "Ada",
      "lastName": "Admin"
    }
  ],
  "browserFlow": "browser-mfa",
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Browser sign-in. Staff and administrators must also give a one-time code (DTAC-5).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie"
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-mfa forms"
        }
      ]
    },
    {
      "alias": "browser-mfa forms",
      "description": "Username and password, then a one-time code for staff and administrators.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-mfa one-time code for staff"
        }
      ]
    },
    {
      "alias": "browser-mfa one-time code for staff",
      "description": "Only when the user holds the staff role (administrators hold it too).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "has-staff-role"
        },
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "has-staff-role",
      "config": {
        "condUserRole": "staff",
        "negate": "false"
      }
    }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": true
}
