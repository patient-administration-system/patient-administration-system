{
  "name": "patient-administration-system-ui-with-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "SvelteKit front-end for the Patient Administration System: staff calendar, waitlist kanban, ward gantt, patient grid, reminder templates, and patient sign-in to see one's own appointments.",
  "license": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "types": "openapi-typescript ../spec/openapi.json -o src/lib/server/api-types.ts && prettier --write src/lib/server/api-types.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests",
    "lint": "prettier --check src tests && eslint .",
    "bundle:check": "node scripts/check-bundle.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-calendar": "0.7.2",
    "@lilydesignsystem/svelte-data-grid": "0.11.2",
    "@lilydesignsystem/svelte-gantt-chart": "0.8.2",
    "@lilydesignsystem/svelte-headless": "0.8.0",
    "@lilydesignsystem/svelte-kanban-board": "0.8.3",
    "@sveltia/i18n": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
