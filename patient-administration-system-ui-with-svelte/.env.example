# PAS REST API base URL (no trailing slash) and the credential the UI's server presents to it.
# Read server-side only; the browser never sees either.
# Per-user authentication (recommended): a file holding a short-lived service token that
# `sh ../scripts/dev-auth.sh` keeps fresh. The UI re-reads it as it rotates.
PAS_API_URL=http://localhost:8080
PAS_API_TOKEN_FILE=../.dev-auth/service.token
# Older shared-token mode, used only when no token file is set:
# PAS_API_TOKEN=

# Keycloak realm from ../podman/keycloak/pas-realm.json
# (start it with: podman compose -f ../podman/compose.yml up -d)
OIDC_ISSUER=http://localhost:8180/realms/pas
OIDC_CLIENT_ID=pas-frontend
OIDC_CLIENT_SECRET=pas_dev_client_secret
OIDC_SCOPES="openid profile email"
# OIDC_REDIRECT_URI=http://localhost:5173/signin/oidc/callback
# OIDC_SESSION_HOURS=8
# OIDC_IDLE_MINUTES=30
# OIDC_SESSION_STORE=memory      # or redis, with REDIS_URL
# OIDC_END_SESSION=true          # also end the Keycloak session on sign-out
