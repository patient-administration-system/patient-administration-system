# Container build for the Patient Administration System UI (SvelteKit, adapter-node).
#
# BUILD CONTEXT IS THIS DIRECTORY:
#
#   podman build --format docker -f Containerfile -t patient-administration-system-ui .
#
# The server side of the UI is a back-end for the browser (sign-in, session cookie, a proxy to the PAS API),
# so it needs PAS_API_URL, PAS_API_TOKEN, OIDC_ISSUER, OIDC_CLIENT_ID (and OIDC_CLIENT_SECRET for a confidential
# client). Behind a TLS-terminating proxy, have it send X-Forwarded-Proto: https (container-server.mjs explains why).
# The Node version equals `engines.node` in package.json.

FROM docker.io/library/node:26-slim AS builder
RUN npm install --global pnpm@12.10.1
WORKDIR /ui
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . ./
RUN pnpm run build \
 && pnpm install --frozen-lockfile --prod

FROM docker.io/library/node:26-slim
# Provenance labels. The release workflow passes the version it verified against the tag and the changelog
# (scripts/release-notes.sh), and checks the built image carries it.
ARG VERSION=unknown
ARG REVISION=unknown
ARG SOURCE=unknown
LABEL org.opencontainers.image.title="patient-administration-system-ui" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only"
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0 PROTOCOL_HEADER=x-forwarded-proto
WORKDIR /app
COPY --from=builder /ui/build ./build
COPY --from=builder /ui/node_modules ./node_modules
COPY --from=builder /ui/package.json ./package.json
COPY container-server.mjs ./container-server.mjs
USER node
EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=3s --retries=20 --start-period=5s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/signin').then(r=>process.exit(r.status<500?0:1),()=>process.exit(1))"]
CMD ["node", "container-server.mjs"]
